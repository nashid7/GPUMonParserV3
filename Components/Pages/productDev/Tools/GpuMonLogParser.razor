@page "/productDev/Tools/gpuMonLogParser"
@using System.Text
@using System.Text.RegularExpressions
@using System.Globalization
@using par.Components.Shared
@using par.Services
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>GPU Monitor Log Parser</PageTitle>

<h3>GPU Monitor Log Parser</h3>
<p>Upload a GPU Monitor log (.log / .txt / .csv) to extract performance metrics when the GPU is at high utilization.</p>

<div class="panel upload-panel">
    <div class="upload-actions">
        <InputFile OnChange="OnFileSelected" accept=".log,.txt,.csv" />
        <button class="btn btn-secondary btn-sm" @onclick="LoadSampleAsync">Load sample</button>
    </div>
    <div class="small-gap"></div>
    <div class="row-controls">
        <label>Utilization range</label>
        <input type="number" min="0" max="100" class="form-control form-control-sm util-input" @bind="_utilMin" />
        <span class="muted">to</span>
        <input type="number" min="0" max="100" class="form-control form-control-sm util-input" @bind="_utilMax" />
        <button class="btn btn-outline-secondary btn-sm" @onclick='(() => ApplyUtilPreset(99, 100))'>99-100</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick='(() => ApplyUtilPreset(95, 100))'>95-100</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick='(() => ApplyUtilPreset(90, 100))'>90-100</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick='(() => ApplyUtilPreset(0, 100))'>All rows</button>
        <button class="btn btn-primary btn-sm" @onclick="ParseAsync" disabled="@(!_fileReady)">Parse Log</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(UploadError)) { <div class="text-danger">@UploadError</div>; }
</div>

@if (ParseComplete)
{
    <div class="panel results-panel">
        <div class="results-header">
            <div>
                <p class="eyebrow">Run summary</p>
                <h4>Metrics at high utilization</h4>
            </div>
            <div class="actions">
                <CopyToClipboard GetTextAsync="GetSummaryClipboardAsync" Tooltip="Copy summary" CopiedTooltip="Summary copied" />
                <button class="btn btn-secondary btn-sm" @onclick="ExportPdfAsync" disabled="@(!ParseComplete)">Export PDF</button>
            </div>
        </div>

        <div class="gpu-info-grid">
            <div class="gpu-info-card brand-card">
                <label>Brand Name</label>
                <div>@BrandNameDisplay</div>
            </div>
            <div class="gpu-info-card">
                <label>VBIOS Version</label>
                <div>@VbiosVersionDisplay</div>
            </div>
            <div class="gpu-info-card">
                <label>Driver Version</label>
                <div>@DriverVersionDisplay</div>
            </div>
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <label>Coverage</label>
                <div class="value">@CoverageDisplay</div>
                <p class="muted">@HighUtilSampleCount.ToString("N0") of @TotalSampleCount.ToString("N0") rows in filter</p>
            </div>
            <div class="summary-card">
                <label>Date</label>
                <div class="value">@TestDate?.ToString("yyyy-MM-dd")</div>
                <p class="muted">Duration @DurationDisplay | Filter @UtilRangeDisplay</p>
            </div>
            <div class="summary-card">
                <label>Peak power (W)</label>
                <div class="value">@Fmt(GtpMaxW)</div>
                <p class="muted">Power column: @PowerColumnDisplay</p>
            </div>
            <div class="summary-card">
                <label>Capping occurrences</label>
                <div class="value">@CappingSampleTotal</div>
                <p class="muted">@CappingSampleSummary</p>
            </div>
        </div>

        <div class="metrics-grid">
            <div class="metric group"><strong>GPU Temp (C)</strong></div>
            <div class="metric"><label>Min</label><div>@Fmt(GpuTjMin)</div></div>
            <div class="metric"><label>Avg</label><div>@Fmt(GpuTjAvg)</div></div>
            <div class="metric"><label>Max</label><div>@Fmt(GpuTjMax)</div></div>
            <div class="metric group"><strong>Memory Temp (C)</strong></div>
            <div class="metric"><label>Min</label><div>@Fmt(MemTjMin)</div></div>
            <div class="metric"><label>Avg</label><div>@Fmt(MemTjAvg)</div></div>
            <div class="metric"><label>Max</label><div>@Fmt(MemTjMax)</div></div>
            <div class="metric group"><strong>Power (W)</strong></div>
            <div class="metric"><label>Min</label><div>@Fmt(GtpMinW)</div></div>
            <div class="metric"><label>Avg</label><div>@Fmt(GtpAvgW)</div></div>
            <div class="metric"><label>Max</label><div>@Fmt(GtpMaxW)</div></div>
            <div class="metric group"><strong>GPC Clock (MHz)</strong></div>
            <div class="metric"><label>Min</label><div>@Fmt(GpcClockMin)</div></div>
            <div class="metric"><label>Avg</label><div>@Fmt(GpcClockAvg)</div></div>
            <div class="metric"><label>Max</label><div>@Fmt(GpcClockMax)</div></div>
            <div class="metric group"><strong>Memory Clock (MHz)</strong></div>
            <div class="metric"><label>Min</label><div>@Fmt(MemoryClockMin)</div></div>
            <div class="metric"><label>Avg</label><div>@Fmt(MemoryClockAvg)</div></div>
            <div class="metric"><label>Max</label><div>@Fmt(MemoryClockMax)</div></div>
        </div>

        @if (FilteredSamples.Any())
        {
            <div class="panel nested">
                <div class="panel-head">
                    <div>
                        <p class="eyebrow">Charts</p>
                        <p class="muted">Visualize filtered samples (util @UtilRangeDisplay). Click a chart to expand.</p>
                    </div>
                </div>
                <div class="chart-grid">
                    <div class="chart-card" @onclick="@(() => OpenChartModalAsync("chart-gpu"))">
                        <div class="chart-title">
                            <p class="eyebrow">GPU Temp (C)</p>
                            <span class="expand">Expand</span>
                        </div>
                        <div class="chart-frame"><canvas id="chart-gpu"></canvas></div>
                    </div>
                    <div class="chart-card" @onclick="@(() => OpenChartModalAsync("chart-power"))">
                        <div class="chart-title">
                            <p class="eyebrow">Power (W)</p>
                            <span class="expand">Expand</span>
                        </div>
                        <div class="chart-frame"><canvas id="chart-power"></canvas></div>
                    </div>
                    <div class="chart-card" @onclick="@(() => OpenChartModalAsync("chart-scatter"))">
                        <div class="chart-title">
                            <p class="eyebrow">Power vs GPU Temp</p>
                            <span class="expand">Expand</span>
                        </div>
                        <div class="chart-frame"><canvas id="chart-scatter"></canvas></div>
                    </div>
                </div>
            </div>
        }

        @if (PStateTimeline.Any())
        {
            <div class="panel nested event-card">
                <div class="panel-head">
                    <div>
                        <p class="eyebrow">P-State dataset</p>
                        <h5>P-State activity</h5>
                        <p class="muted">Sample totals and continuous periods across the complete test. A new period begins whenever the state changes.</p>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick='(() => OpenChartModalAsync("chart-pstate-timeline"))'>Expand</button>
                </div>
                <div class="event-counts">
                    @foreach (var item in PStateSampleCounts.OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <div class="event-count" style="@($"--event-color:{TimelineColor(item.Key)}")">
                            <div class="event-count-title"><i></i><span>@item.Key</span></div>
                            <div class="event-count-value"><strong>@item.Value.ToString("N0")</strong><small>samples</small></div>
                            <div class="event-count-periods">@PStateEventCounts.GetValueOrDefault(item.Key) continuous @(PStateEventCounts.GetValueOrDefault(item.Key) == 1 ? "period" : "periods")</div>
                        </div>
                    }
                </div>
                <div class="timeline-toolbar" aria-label="P-State timeline controls">
                    <div class="toolbar-group">
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-pstate-timeline", "previous"))'>← Previous change</button>
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-pstate-timeline", "next"))'>Next change →</button>
                    </div>
                    <div class="toolbar-group">
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-pstate-timeline", "zoomIn"))'>＋ Zoom</button>
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-pstate-timeline", "zoomOut"))'>− Zoom</button>
                    </div>
                    <div class="toolbar-group">
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-pstate-timeline", "window60"))'>1 minute</button>
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-pstate-timeline", "window300"))'>5 minutes</button>
                        <button class="timeline-btn primary" @onclick='(() => ControlTimelineAsync("chart-pstate-timeline", "full"))'>Full test</button>
                    </div>
                    <span class="timeline-help">Scroll to zoom <b>·</b> drag to pan <b>·</b> hover to inspect</span>
                </div>
                <div class="timeline-frame pstate-timeline-frame">
                    <canvas id="chart-pstate-timeline"></canvas>
                </div>
            </div>
        }

        @if (CappingTimeline.Any())
        {
            <div class="panel nested event-card">
                <div class="panel-head">
                    <div>
                        <p class="eyebrow">Capping dataset</p>
                        <h5>Capping reason activity</h5>
                        <p class="muted">Sample totals and continuous periods for each reason, with every change shown across the complete test.</p>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick='(() => OpenChartModalAsync("chart-capping-timeline"))'>Expand</button>
                </div>
                <div class="event-counts">
                    @foreach (var item in CappingSampleCounts.OrderBy(item => CappingReasonOrder(item.Key)).ThenBy(item => item.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <div class="event-count" style="@($"--event-color:{TimelineColor(item.Key)}")">
                            <div class="event-count-title"><i></i><span>@CappingReasonDisplay(item.Key)</span></div>
                            <div class="event-count-value"><strong>@item.Value.ToString("N0")</strong><small>samples</small></div>
                            <div class="event-count-periods">@CappingEventCounts.GetValueOrDefault(item.Key) continuous @(CappingEventCounts.GetValueOrDefault(item.Key) == 1 ? "period" : "periods")</div>
                        </div>
                    }
                </div>
                <div class="timeline-toolbar" aria-label="Capping timeline controls">
                    <div class="toolbar-group">
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-capping-timeline", "previous"))'>← Previous change</button>
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-capping-timeline", "next"))'>Next change →</button>
                    </div>
                    <div class="toolbar-group">
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-capping-timeline", "zoomIn"))'>＋ Zoom</button>
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-capping-timeline", "zoomOut"))'>− Zoom</button>
                    </div>
                    <div class="toolbar-group">
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-capping-timeline", "window60"))'>1 minute</button>
                        <button class="timeline-btn" @onclick='(() => ControlTimelineAsync("chart-capping-timeline", "window300"))'>5 minutes</button>
                        <button class="timeline-btn primary" @onclick='(() => ControlTimelineAsync("chart-capping-timeline", "full"))'>Full test</button>
                    </div>
                    <span class="timeline-help">Scroll to zoom <b>·</b> drag to pan <b>·</b> hover to inspect</span>
                </div>
                <div class="timeline-frame">
                    <canvas id="chart-capping-timeline"></canvas>
                </div>
            </div>
        }
    </div>
}

<div class="chart-modal @(ShowChartModal ? "show" : "")" @onclick="CloseChartModal">
    <div class="chart-modal-body" @onclick:stopPropagation="true">
        <div class="chart-modal-header">
            <span>Chart</span>
            <button class="btn btn-sm btn-secondary" @onclick="CloseChartModal">Close</button>
        </div>
        <div class="chart-modal-frame">
            <canvas id="chart-modal-canvas"></canvas>
        </div>
    </div>
</div>

<style>
    .upload-panel, .results-panel { border:1px solid #1f2d4a; padding:18px; border-radius:14px; background:linear-gradient(160deg,#0f172a,#0c1627); margin-top:16px; box-shadow:0 16px 48px rgba(0,0,0,0.4); color:#e5e7eb; }
    .panel.nested { margin-top:18px; padding:16px; border-radius:12px; background:linear-gradient(160deg,#0c1628,#0a1323); border:1px solid #223252; box-shadow:inset 0 1px 0 rgba(255,255,255,.025), 0 10px 28px rgba(0,0,0,.18); }
    .panel-head{display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:14px;}
    .small-gap{height:6px;}
    .upload-actions{display:flex; gap:10px; flex-wrap:wrap; align-items:center;}
    .row-controls{display:flex; align-items:center; gap:10px; flex-wrap:wrap;}
    .metrics-grid{display:grid; grid-template-columns: repeat(auto-fit,minmax(140px,1fr)); gap:8px; margin-top:15px;}
    .metric{background:#111a2e; border:1px solid #1f2d4a; padding:10px 12px; border-radius:8px; font-size:0.92rem; color:#e5e7eb;}
    .metric label{display:block; font-size:0.68rem; text-transform:uppercase; color:#cbd5e1; letter-spacing:.5px;}
    .metric.group{grid-column:1/-1; background:#0b1324; text-align:left; font-size:0.9rem; color:#e5e7eb;}
    .log-lines{max-height:300px; overflow:auto; background:#0a1120; color:#e2e8f0; font-family:monospace; padding:12px; margin-top:6px; font-size:0.84rem; border-radius:8px; border:1px solid #1f2d4a;}
    .results-header{display:flex; align-items:center; justify-content:space-between; gap:12px;}
    .gpu-info-grid{display:grid; grid-template-columns:2fr 1fr 1fr; gap:8px; margin:12px 0;}
    .gpu-info-card{background:#111a2e; border:1px solid #1f2d4a; border-radius:8px; padding:10px 12px; color:#f8fafc; min-width:0;}
    .gpu-info-card label{display:block; font-size:0.68rem; text-transform:uppercase; color:#cbd5e1; letter-spacing:.5px; margin-bottom:2px;}
    .gpu-info-card div{font-size:0.92rem; overflow-wrap:anywhere;}
    .summary-grid{display:grid; grid-template-columns: repeat(auto-fit,minmax(200px,1fr)); gap:10px; margin:12px 0;}
    .summary-card{background:#111a2e; border:1px solid #1f2d4a; border-radius:10px; padding:12px; color:#e5e7eb;}
    .summary-card label{font-size:0.72rem; text-transform:uppercase; color:#cbd5e1; letter-spacing:.3px;}
    .summary-card .value{font-size:1.25rem; font-weight:700; color:#f8fafc;}
    .summary-card .muted{margin-top:2px;}
    .muted{color:#cbd5e1; font-size:0.88rem;}
    .eyebrow{font-size:0.7rem; text-transform:uppercase; letter-spacing:.4px; color:#cbd5e1; margin:0;}
    .actions{display:flex; gap:8px;}
    .list{list-style:none; padding:0; margin:0; display:grid; gap:6px;}
    .chart-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:12px;}
    .chart-card{background:#111a2e; border:1px solid #1f2d4a; border-radius:10px; padding:10px; cursor:pointer; transition:transform .15s ease, border-color .15s ease;}
    .chart-card:hover{transform:translateY(-2px); border-color:#38bdf8;}
    .chart-frame{height:240px;}
    select.form-select, .util-input { background-color:#0b1324; border:1px solid #1f2d4a; color:#e5e7eb; }
    .util-input { width:88px; }
    button.btn { border-radius:8px; }
    .chart-title{display:flex; justify-content:space-between; align-items:center;}
    .chart-title .expand{font-size:0.75rem; color:#93c5fd;}
    .event-card{overflow:hidden;}
    .event-card .eyebrow{color:#7dd3fc; font-weight:700; letter-spacing:.08em;}
    .event-card h5{margin:3px 0 5px; color:#f8fafc; font-size:1.16rem; font-weight:650; line-height:1.25;}
    .event-card .panel-head .muted{margin:0; max-width:760px; color:#94a3b8; line-height:1.45;}
    .event-card .panel-head .btn{flex:0 0 auto; border-color:#405374; color:#cbd5e1; background:#0b1424;}
    .event-card .panel-head .btn:hover{border-color:#60a5fa; color:#fff; background:#17233a;}
    .event-counts{display:flex; flex-wrap:wrap; gap:10px; margin:4px 0 16px;}
    .event-count{position:relative; min-width:150px; padding:11px 13px 10px 15px; border:1px solid #253755; border-left:3px solid var(--event-color); border-radius:10px; background:linear-gradient(145deg,rgba(22,34,56,.95),rgba(14,25,44,.95)); color:#e5e7eb; box-shadow:inset 0 1px 0 rgba(255,255,255,.025);}
    .event-count-title{display:flex; align-items:center; gap:7px; margin-bottom:5px;}
    .event-count-title i{width:7px; height:7px; border-radius:50%; background:var(--event-color); box-shadow:0 0 8px color-mix(in srgb,var(--event-color) 70%,transparent);}
    .event-count-title span{font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#cbd5e1;}
    .event-count-value{display:flex; align-items:baseline; gap:6px;}
    .event-count-value strong{font-size:1.3rem; line-height:1.1; color:#f8fafc;}
    .event-count-value small{font-size:.72rem; color:#94a3b8;}
    .event-count-periods{margin-top:7px; padding-top:7px; border-top:1px solid rgba(148,163,184,.12); font-size:.68rem; color:#93c5fd;}
    .timeline-toolbar{display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin:0 0 10px; padding-top:12px; border-top:1px solid rgba(148,163,184,.12);}
    .toolbar-group{display:inline-flex; gap:3px; padding:3px; border:1px solid #263754; border-radius:9px; background:#091221;}
    .timeline-btn{appearance:none; border:0; border-radius:6px; padding:5px 8px; background:transparent; color:#aebed2; font-size:.72rem; line-height:1.2; cursor:pointer; transition:background .15s ease,color .15s ease,box-shadow .15s ease;}
    .timeline-btn:hover{background:#1a2942; color:#f8fafc;}
    .timeline-btn:focus-visible{outline:2px solid #38bdf8; outline-offset:1px;}
    .timeline-btn.primary{background:#17263e; color:#dbeafe; box-shadow:inset 0 0 0 1px #36527c;}
    .timeline-help{margin-left:auto; color:#8293aa; font-size:.7rem; white-space:nowrap;}
    .timeline-help b{color:#3b82f6; font-weight:700;}
    .timeline-frame{position:relative; height:280px; background:linear-gradient(180deg,#08111f,#091423); border:1px solid #253857; border-radius:12px; padding:12px; box-shadow:inset 0 1px 12px rgba(0,0,0,.2);}
    .pstate-timeline-frame{height:240px;}
    .timeline-pointer-readout{position:absolute; z-index:3; display:grid; gap:5px; min-width:120px; max-width:260px; padding:7px 9px; border:1px solid #475569; border-radius:8px; background:rgba(2,6,23,.94); color:#f8fafc; box-shadow:0 8px 24px rgba(0,0,0,.4); pointer-events:none; opacity:0; transition:opacity .1s ease;}
    .timeline-pointer-readout.show{opacity:1;}
    .pointer-time{font-size:.75rem; font-weight:700; color:#e2e8f0;}
    .pointer-badges{display:flex; flex-wrap:wrap; gap:4px;}
    .pointer-badge{padding:2px 6px; border:1px solid currentColor; border-radius:999px; font-size:.68rem; font-weight:700; text-transform:uppercase; background:rgba(15,23,42,.9);}
    .pointer-overlap{font-size:.66rem; color:#fbbf24;}
    .chart-modal{position:fixed; inset:0; background:rgba(6,10,18,0.76); backdrop-filter: blur(5px); display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity .2s ease;}
    .chart-modal.show{opacity:1; pointer-events:auto;}
    .chart-modal-body{background:#0b1324; border:1px solid #1f2d4a; border-radius:12px; padding:14px; width: min(90vw, 1100px); height:min(85vh, 700px); display:flex; flex-direction:column; box-shadow:0 30px 80px rgba(0,0,0,0.55);}
    .chart-modal-header{display:flex; justify-content:space-between; align-items:center; color:#e5e7eb; margin-bottom:8px;}
    .chart-modal-frame{position:relative; flex:1; background:#0a1120; border:1px solid #1f2d4a; border-radius:10px; padding:10px;}
    .chart-modal-frame canvas{width:100%!important; height:100%!important;}
    @@media (max-width: 960px) {
        .timeline-help{width:100%; margin-left:0;}
    }
    @@media (max-width: 720px) {
        .gpu-info-grid{grid-template-columns:1fr;}
        .panel.nested{padding:12px;}
        .event-count{flex:1 1 140px; min-width:0;}
        .toolbar-group{width:100%;}
        .timeline-btn{flex:1;}
        .timeline-frame{height:250px; padding:8px;}
        .pstate-timeline-frame{height:220px;}
    }
</style>

@code {
    private IBrowserFile? _file;
    private bool _fileReady => _file is not null;
    private string UploadError { get; set; } = string.Empty;
    private int _utilMin { get; set; } = 99;
    private int _utilMax { get; set; } = 100;
    private string PowerColumnDisplay => _powerColumn ?? "n/a";
    private string UtilColumnDisplay => _utilColumn ?? "n/a";
    private string UtilRangeDisplay => $"{NormalizedUtilMin}-{NormalizedUtilMax}%";

    // Parsed metrics
    private DateTime? TestDate { get; set; }
    private int HighUtilSampleCount { get; set; }
    private int TotalSampleCount { get; set; }
    private decimal? GpuTjAvg; private decimal? GpuTjMin; private decimal? GpuTjMax;
    private decimal? MemTjAvg; private decimal? MemTjMin; private decimal? MemTjMax;
    private decimal? GtpAvgW; private decimal? GtpMinW; private decimal? GtpMaxW; // in W (converted)
    private decimal? GpcClockAvg; private decimal? GpcClockMin; private decimal? GpcClockMax;
    private decimal? MemoryClockAvg; private decimal? MemoryClockMin; private decimal? MemoryClockMax;
    private string? _powerColumn;
    private string? _utilColumn;
    private string BrandNameDisplay { get; set; } = "n/a";
    private string VbiosVersionDisplay { get; set; } = "n/a";
    private string DriverVersionDisplay { get; set; } = "n/a";
    private int? _maxUtil;
    private TimeSpan Duration { get; set; }
    private string DurationDisplay => Duration == TimeSpan.Zero ? "" : Duration.ToString();
    private string CoverageDisplay => TotalSampleCount == 0 ? "--" : $"{(HighUtilSampleCount * 100m / TotalSampleCount):0.0}%";
    private int CappingSampleTotal => CappingSampleCounts.Values.Sum();
    private string CappingSampleSummary => CappingSampleTotal == 0
        ? "No capping detected."
        : $"{CappingSampleTotal} active reason samples across the full test.";
    private List<string> FilteredLines { get; set; } = new();
    private List<SamplePoint> FilteredSamples { get; set; } = new();
    private List<StateSample> StateSamples { get; set; } = new();
    private List<TimelineSegment> PStateTimeline { get; set; } = new();
    private List<TimelineSegment> CappingTimeline { get; set; } = new();
    private Dictionary<string, int> PStateSampleCounts { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> CappingSampleCounts { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> PStateEventCounts { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> CappingEventCounts { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private bool ParseComplete { get; set; }
    private bool ShowChartModal { get; set; }
    private string? _modalSourceId;
    private bool _chartsDirty;

    private record SamplePoint(int Index, decimal? GpuTj, decimal? MemTj, decimal? PowerW, int? Util, DateTime? Timestamp);
    private record StateSample(int Index, DateTime? Timestamp, string PState, string CappingReason);
    private record TimelineSegment(string Label, double StartSeconds, double EndSeconds, string StartTime, string EndTime, double DurationSeconds);
    private record CsvMetricSpec(string Key, bool PreferPopulated, params string[] Aliases);

    private static readonly CsvMetricSpec[] CsvMetricSpecs =
    {
        new("date", false, "date"),
        new("time", false, "time"),
        new("timestamp", false, "timestamp", "datetime"),
        new("util", false, "gpc_util", "gpu_utilization", "gpu_util", "utilization", "util"),
        new("gpu_temp", true, "gpu_tj", "t_gpu", "gpu_temp", "gpu_temp_c", "temperature_gpu"),
        new("mem_temp", true, "mem_tj", "mem_temp", "memory_tj", "memory_temp", "temperature_memory"),
        new("gpc_clock", true, "gpc_clock", "gpc_clock_mhz", "graphics_clock", "gpu_clock", "clock_gpu"),
        new("memory_clock", true, "memory_clock", "memory_clock_mhz", "mem_clock", "clock_memory"),
        new("power", true, "tgp", "tgp_w", "gtp", "pwr_tgp", "gtp_mw", "tpp_measured"),
        new("pstate", false, "p_state", "pstate", "performance_state"),
        new("throttle_reason", false, "capping_reason", "throttle_reason", "reason")
    };

    private int NormalizedUtilMin => Math.Clamp(Math.Min(_utilMin, _utilMax), 0, 100);
    private int NormalizedUtilMax => Math.Clamp(Math.Max(_utilMin, _utilMax), 0, 100);

    private static string NormalizeHeader(string header)
    {
        var value = header.Trim().Trim('"').ToLowerInvariant();
        if (value.Length > 1 && char.IsDigit(value[0]) && value.Contains(':'))
        {
            var idx = value.IndexOf(':');
            value = value[(idx + 1)..];
        }

        var paren = value.IndexOf('(');
        if (paren >= 0) value = value[..paren];

        value = value.Replace("%", "").Replace("/", " ").Replace("-", " ").Replace(".", " ");
        value = string.Join('_', value.Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries));
        return value.Replace("__", "_").Trim('_').Trim();
    }

    private static bool HeaderMatchesAlias(string cleanedHeader, string alias)
    {
        if (string.Equals(cleanedHeader, alias, StringComparison.OrdinalIgnoreCase))
            return true;

        if (cleanedHeader.Contains(alias, StringComparison.OrdinalIgnoreCase))
            return true;

        var headerTokens = cleanedHeader.Split('_', StringSplitOptions.RemoveEmptyEntries);
        var aliasTokens = alias.Split('_', StringSplitOptions.RemoveEmptyEntries);
        return aliasTokens.Length > 1 && aliasTokens.All(token =>
            token.Length <= 2
                ? headerTokens.Any(headerToken => string.Equals(headerToken, token, StringComparison.OrdinalIgnoreCase))
                : headerTokens.Any(headerToken => string.Equals(headerToken, token, StringComparison.OrdinalIgnoreCase) ||
                                                 headerToken.Contains(token, StringComparison.OrdinalIgnoreCase)));
    }

    private void ParseGpuMetadata(string[] lines)
    {
        var sectionIndex = Array.FindIndex(lines, line =>
            line.Contains("*** GPU Informations ***", StringComparison.OrdinalIgnoreCase) ||
            line.Contains("*** GPU Information ***", StringComparison.OrdinalIgnoreCase));
        if (sectionIndex < 0) return;

        var headerIndex = -1;
        var valueIndex = -1;
        for (var i = sectionIndex + 1; i < lines.Length; i++)
        {
            if (lines[i].StartsWith("***", StringComparison.Ordinal)) break;
            if (string.IsNullOrWhiteSpace(lines[i].Trim(','))) continue;
            if (headerIndex < 0)
            {
                headerIndex = i;
                continue;
            }

            valueIndex = i;
            break;
        }

        if (headerIndex < 0 || valueIndex < 0) return;

        var headers = SplitDelimitedLine(lines[headerIndex], ',');
        var values = SplitDelimitedLine(lines[valueIndex], ',');
        var metadata = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i < headers.Length && i < values.Length; i++)
        {
            var key = NormalizeHeader(headers[i]);
            if (!string.IsNullOrWhiteSpace(key) && !metadata.ContainsKey(key))
                metadata[key] = values[i].Trim();
        }

        BrandNameDisplay = GetMetadataValue(metadata, "brand_name");
        VbiosVersionDisplay = GetMetadataValue(metadata, "vbios_version", "vbios");
        DriverVersionDisplay = GetMetadataValue(metadata, "driver_version");
    }

    private static string GetMetadataValue(Dictionary<string, string> metadata, params string[] aliases)
    {
        foreach (var alias in aliases)
        {
            if (metadata.TryGetValue(alias, out var value) &&
                !string.IsNullOrWhiteSpace(value) &&
                !value.Equals("n/a", StringComparison.OrdinalIgnoreCase))
            {
                return value;
            }
        }

        return "n/a";
    }

    private void BuildEventTimelines()
    {
        PStateTimeline = new();
        CappingTimeline = new();
        PStateSampleCounts = new(StringComparer.OrdinalIgnoreCase);
        CappingSampleCounts = new(StringComparer.OrdinalIgnoreCase);
        PStateEventCounts = new(StringComparer.OrdinalIgnoreCase);
        CappingEventCounts = new(StringComparer.OrdinalIgnoreCase);
        if (!StateSamples.Any()) return;

        PStateSampleCounts = StateSamples
            .GroupBy(sample => NormalizePState(sample.PState), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
        CappingSampleCounts = StateSamples
            .SelectMany(sample => ParseCappingReasons(sample.CappingReason))
            .GroupBy(reason => reason, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);

        var timelineStart = StateSamples.Select(sample => sample.Timestamp).FirstOrDefault(timestamp => timestamp.HasValue);
        var positions = StateSamples
            .Select(sample => timelineStart.HasValue && sample.Timestamp.HasValue
                ? Math.Max(0, (sample.Timestamp.Value - timelineStart.Value).TotalSeconds)
                : (double)sample.Index)
            .ToArray();

        var positiveIntervals = positions.Zip(positions.Skip(1), (left, right) => right - left)
            .Where(interval => interval > 0)
            .OrderBy(interval => interval)
            .ToArray();
        var sampleInterval = positiveIntervals.Any()
            ? positiveIntervals[positiveIntervals.Length / 2]
            : 1d;

        var currentPState = NormalizePState(StateSamples[0].PState);
        var pStateStart = positions[0];
        for (var i = 1; i < StateSamples.Count; i++)
        {
            var nextPState = NormalizePState(StateSamples[i].PState);
            if (string.Equals(currentPState, nextPState, StringComparison.OrdinalIgnoreCase)) continue;

            AddTimelineSegment(PStateTimeline, currentPState, pStateStart, positions[i], timelineStart);
            currentPState = nextPState;
            pStateStart = positions[i];
        }
        AddTimelineSegment(PStateTimeline, currentPState, pStateStart, positions[^1] + sampleInterval, timelineStart);

        var reasons = StateSamples
            .SelectMany(sample => ParseCappingReasons(sample.CappingReason))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(CappingReasonOrder)
            .ThenBy(reason => reason, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        foreach (var reason in reasons)
        {
            double? eventStart = null;
            for (var i = 0; i < StateSamples.Count; i++)
            {
                var isActive = ParseCappingReasons(StateSamples[i].CappingReason)
                    .Contains(reason, StringComparer.OrdinalIgnoreCase);
                if (isActive && !eventStart.HasValue)
                {
                    eventStart = positions[i];
                }
                else if (!isActive && eventStart.HasValue)
                {
                    AddTimelineSegment(CappingTimeline, reason, eventStart.Value, positions[i], timelineStart);
                    eventStart = null;
                }
            }

            if (eventStart.HasValue)
                AddTimelineSegment(CappingTimeline, reason, eventStart.Value, positions[^1] + sampleInterval, timelineStart);
        }

        PStateEventCounts = PStateTimeline
            .GroupBy(segment => segment.Label, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
        CappingEventCounts = CappingTimeline
            .GroupBy(segment => segment.Label, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
    }

    private static void AddTimelineSegment(List<TimelineSegment> timeline, string label, double startSeconds, double endSeconds, DateTime? timelineStart)
    {
        if (endSeconds <= startSeconds) endSeconds = startSeconds + 0.001;
        var startTime = timelineStart.HasValue
            ? timelineStart.Value.AddSeconds(startSeconds).ToString("HH:mm:ss.fff")
            : $"+{TimeSpan.FromSeconds(startSeconds):mm\\:ss}";
        var endTime = timelineStart.HasValue
            ? timelineStart.Value.AddSeconds(endSeconds).ToString("HH:mm:ss.fff")
            : $"+{TimeSpan.FromSeconds(endSeconds):mm\\:ss}";
        timeline.Add(new TimelineSegment(label, startSeconds, endSeconds, startTime, endTime, endSeconds - startSeconds));
    }

    private static string NormalizePState(string value)
        => string.IsNullOrWhiteSpace(value) || value.Equals("n/a", StringComparison.OrdinalIgnoreCase)
            ? "Unknown"
            : value.Trim().ToUpperInvariant();

    private static IReadOnlyList<string> ParseCappingReasons(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw) ||
            raw.Equals("none", StringComparison.OrdinalIgnoreCase) ||
            raw.Equals("n/a", StringComparison.OrdinalIgnoreCase))
        {
            return Array.Empty<string>();
        }

        return raw.Split(new[] { ' ', ',', ';', '|', '+' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(reason => reason.ToLowerInvariant() switch
            {
                "pwr" or "power" => "Pwr",
                "thml" or "thermal" => "Thml",
                "vrel" => "VRel",
                "vop" => "VOp",
                "util" or "utilization" => "Util",
                _ => reason
            })
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static string CappingReasonDisplay(string reason) => reason.ToLowerInvariant() switch
    {
        "pwr" => "Power",
        "thml" => "Thermal",
        "vrel" => "VRel",
        "vop" => "VOp",
        "util" => "Utilization",
        _ => reason
    };

    private static int CappingReasonOrder(string reason) => reason.ToLowerInvariant() switch
    {
        "pwr" => 0,
        "thml" => 1,
        "vrel" => 2,
        "vop" => 3,
        "util" => 4,
        _ => 100
    };

    private static string TimelineColor(string label) => label.ToLowerInvariant() switch
    {
        "pwr" => "#f59e0b",
        "thml" => "#ef4444",
        "vrel" => "#a855f7",
        "vop" => "#ec4899",
        "util" => "#38bdf8",
        "p0" => "#22c55e",
        "p2" => "#14b8a6",
        "p3" => "#3b82f6",
        "p4" => "#6366f1",
        "p5" => "#8b5cf6",
        "p8" => "#64748b",
        _ => "#94a3b8"
    };

    private int ScoreColumnPopulation(string[] lines, int headerIndex, char delimiter, int columnIndex)
    {
        var score = 0;
        for (int li = headerIndex + 1; li < lines.Length; li++)
        {
            var raw = lines[li];
            if (string.IsNullOrWhiteSpace(raw)) continue;

            var cols = SplitDelimitedLine(raw, delimiter);
            if (cols.Length == 1 && raw.Contains(' '))
                cols = Regex.Split(raw.Trim(), @"\s+");

            if (columnIndex >= 0 && columnIndex < cols.Length && !IsNA(cols[columnIndex]))
                score++;
        }

        return score;
    }

    private int ResolveCsvMetricIndex(string metricKey, Dictionary<string, int> headerMap, IReadOnlyList<string> cleanedHeaders, string[] lines, int headerIndex, char delimiter)
    {
        var spec = CsvMetricSpecs.FirstOrDefault(x => string.Equals(x.Key, metricKey, StringComparison.OrdinalIgnoreCase));
        if (spec is null) return -1;

        var candidates = new List<int>();

        foreach (var alias in spec.Aliases)
        {
            if (headerMap.TryGetValue(alias, out var exactIdx) && !candidates.Contains(exactIdx))
                candidates.Add(exactIdx);
        }

        for (int i = 0; i < cleanedHeaders.Count; i++)
        {
            var cleanedHeader = cleanedHeaders[i];
            if (string.Equals(spec.Key, "power", StringComparison.OrdinalIgnoreCase) &&
                (cleanedHeader.Contains("timestamp", StringComparison.OrdinalIgnoreCase) ||
                 cleanedHeader.Contains("voltage", StringComparison.OrdinalIgnoreCase) ||
                 cleanedHeader.Contains("current", StringComparison.OrdinalIgnoreCase) ||
                 cleanedHeader.Contains("energy", StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }
            if (spec.Aliases.Any(alias => HeaderMatchesAlias(cleanedHeader, alias)) && !candidates.Contains(i))
                candidates.Add(i);
        }

        if (!candidates.Any()) return -1;
        if (!spec.PreferPopulated || candidates.Count == 1) return candidates[0];

        return candidates
            .Select(idx => new { Index = idx, Score = ScoreColumnPopulation(lines, headerIndex, delimiter, idx) })
            .OrderByDescending(x => x.Score)
            .ThenBy(x => x.Index)
            .Select(x => x.Index)
            .First();
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _file = e.File;
        UploadError = string.Empty;
        ParseComplete = false;
        FilteredLines.Clear();

        var ext = Path.GetExtension(_file.Name).ToLowerInvariant();
        if (ext is not ".log" and not ".txt" and not ".csv")
        {
            UploadError = "Invalid file type";
            _file = null;
        }
        return Task.CompletedTask;
    }

