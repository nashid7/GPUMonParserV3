@page "/productDev/Tools/gpuMonLogParser"
@using System.Text
@using System.Globalization
@using par.Components.Shared
@using par.Services
@inject GpuMonLogAnalyzer Analyzer
@inject LogHandoffService Handoff
@inject IJSRuntime JS
@inject ILogger<GpuMonLogParser> Logger
@rendermode InteractiveServer

<PageTitle>GPU Monitor Log Parser</PageTitle>

<div class="page-head">
    <h3>Analyze a GPU Monitor log</h3>
    <p class="muted">Drop a GPUMON .csv to check TGP and review performance within the selected GPU utilization range.</p>
</div>

<div class="dropzone @(_dragOver ? "over" : "") @(_analysis is not null ? "compact" : "")"
     @ondragenter="() => _dragOver = true" @ondragleave="() => _dragOver = false" @ondrop="() => _dragOver = false">
    <InputFile OnChange="OnFileSelectedAsync" accept=".csv,text/csv" class="dropzone-input" title="Choose a GPUMON .csv file" />
    <div class="dropzone-text">
        @if (_isParsing)
        {
            <span class="spinner" aria-hidden="true"></span>
            <strong>Analyzing @_pendingName…</strong>
        }
        else if (_sourceName is not null)
        {
            <strong>@_sourceName</strong>
            <span>Drop another log or click to replace</span>
        }
        else
        {
            <strong>Drop a GPUMON .csv here</strong>
            <span>or click to browse</span>
        }
    </div>
</div>
@if (_error is not null)
{
    <div class="notice error" role="alert">@_error</div>
}

<div class="settings-wrap">
    <AnalysisSettingsBar @ref="_settingsBar" Settings="_settings" OnChanged="OnSettingsChanged" />
</div>

@if (_analysis is not null && _log is not null)
{
    var check = _analysis.TgpCheck;
    <section class="results">
        <div class="result-head">
            <div class="result-title">
                <h4 title="@_sourceName">@_sourceName</h4>
                <p>@_log.BrandName · VBIOS @_log.VbiosVersion · Driver @_log.DriverVersion@(TestDate is null ? "" : $" · {TestDate:yyyy-MM-dd}")@(DurationDisplay == "" ? "" : $" · {DurationDisplay}")</p>
            </div>
            <div class="result-actions">
                <CopyToClipboard GetTextAsync="GetSummaryClipboardAsync" Tooltip="Copy summary" CopiedTooltip="Summary copied" />
                <button class="btn btn-primary btn-sm" @onclick="ExportPdfAsync" disabled="@_isExporting">@(_isExporting ? "Building PDF…" : "Export PDF")</button>
            </div>
        </div>

        <div class="verdict @TgpCssClass">
            <div class="verdict-badge">@check.Verdict</div>
            <div class="verdict-body">
                <div class="verdict-caption">TGP check · @_sourceName</div>
                <div class="verdict-main">
                    @Pct(check.PercentAtOrAbove) of in-range samples ≥ @Fmt(check.ExpectedWatts) W
                    <span>· required @Fmt(check.RequiredPercent)%</span>
                </div>
                <div class="verdict-detail">
                    @if (check.Passed == false)
                    {
                        <span>Needs <b>@check.SamplesShort.ToString("N0")</b> more @(check.SamplesShort == 1 ? "sample" : "samples") ≥ @Fmt(check.ExpectedWatts) W to pass.</span>
                    }
                    @if (check.PassingTgpWatts is not null)
                    {
                        <span>Would pass up to <b>@Fmt(check.PassingTgpWatts) W</b> expected TGP.</span>
                    }
                    <span>@check.SamplesAtOrAbove.ToString("N0") of @check.SampleCount.ToString("N0") samples · @_analysis.UtilizationRange utilization · @_analysis.CoveragePercent.ToString("0.#", CultureInfo.InvariantCulture)% of the test</span>
                </div>
            </div>
        </div>
        @if (_analysis.ReliabilityWarning is { } warning)
        {
            <div class="notice warn">@warning</div>
        }

        <table class="metrics-table">
            <thead><tr><th>Metric</th><th>Min</th><th>Average</th><th>Max</th></tr></thead>
            <tbody>
                @foreach (var (label, stats) in MetricRows)
                {
                    <tr><th scope="row">@label</th><td>@Fmt(stats.Minimum)</td><td class="avg">@Fmt(stats.Average)</td><td>@Fmt(stats.Maximum)</td></tr>
                }
            </tbody>
        </table>

        @if (_analysis.InRangeSamples.Count > 0)
        {
            <div class="charts-block">
                <div id="main-chart-sync-readout" class="chart-sync-readout" aria-live="polite"><span class="readout-hint">Hover the charts to read every value at the same moment. Click a chart to expand it.</span></div>
                <div class="chart-grid">
                    @foreach (var (id, title) in ChartCards)
                    {
                        <div class="chart-card @(id == "chart-power" ? "wide" : "")" @onclick="() => OpenChartModalAsync(id)" title="Click to expand">
                            <div class="chart-title">@title</div>
                            <div class="chart-frame"><canvas id="@id"></canvas></div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_analysis.PStateTimeline.Count > 0)
        {
            <ActivityPanel Title="P-State" ChartId="chart-pstate-timeline" Items="PStateSummary" LabelFor="label => label"
                           ColorFor="TimelineColor" UtilizationRange="@_analysis.UtilizationRange" OnExpand="OpenChartModalAsync" OnCommand="ControlTimelineAsync" />
        }
        @if (_analysis.CappingTimeline.Count > 0)
        {
            <ActivityPanel Title="Capping reason" ChartId="chart-capping-timeline" Items="CappingSummary" LabelFor="GpuMonLogAnalyzer.CappingReasonDisplay"
                           ColorFor="TimelineColor" UtilizationRange="@_analysis.UtilizationRange" OnExpand="OpenChartModalAsync" OnCommand="ControlTimelineAsync" />
        }

        <details class="data-source">
            <summary>Data source</summary>
            <dl>
                <dt>File</dt><dd>@_sourceName</dd>
                <dt>Tool version</dt><dd>@_log.ToolVersion</dd>
                <dt>Samples</dt><dd>@_analysis.InRangeSamples.Count.ToString("N0") of @_log.Samples.Count.ToString("N0") within @_analysis.UtilizationRange</dd>
                @if (_appliedPreset is not null)
                {
                    <dt>Preset</dt><dd>@_appliedPreset (applied from file name)</dd>
                }
                @foreach (var (label, column) in ColumnRows(_log.Columns))
                {
                    <dt>@label</dt><dd>@(column ?? "not found")</dd>
                }
            </dl>
            <p class="muted">Columns are matched by header name, so the column order in the log does not matter.</p>
        </details>
    </section>
}

<div class="chart-modal @(ShowChartModal ? "show" : "")" @onclick="CloseChartModal">
    <div class="chart-modal-body" @onclick:stopPropagation="true">
        <div class="chart-modal-header">
            <span>Scroll to zoom</span>
            <button class="btn btn-sm btn-secondary" @onclick="CloseChartModal">Close</button>
        </div>
        <div class="chart-modal-frame">
            <canvas id="chart-modal-canvas"></canvas>
        </div>
    </div>
</div>

<style>
    .page-head h3{margin:0 0 4px;color:#f8fafc}
    .muted{color:#94a3b8;font-size:.88rem}
    .dropzone{position:relative;display:flex;align-items:center;justify-content:center;min-height:120px;margin-top:14px;border:2px dashed #36527c;border-radius:14px;background:#0d1729;transition:border-color .15s,background .15s,min-height .15s}
    .dropzone:hover,.dropzone.over{border-color:#38bdf8;background:#0f1d33}
    .dropzone.compact{min-height:58px}
    .dropzone-input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
    .dropzone-text{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center;pointer-events:none;color:#cbd5e1;text-align:center}
    .dropzone-text strong{color:#f8fafc}
    .dropzone-text span{color:#94a3b8;font-size:.86rem}
    .spinner{width:18px;height:18px;border:2px solid #36527c;border-top-color:#38bdf8;border-radius:50%;animation:spin .8s linear infinite}
    @@keyframes spin{to{transform:rotate(360deg)}}
    .settings-wrap{margin-top:12px}
    .notice{margin-top:10px;padding:9px 12px;border-radius:9px;font-size:.86rem}
    .notice.error{border:1px solid #7f1d1d;background:#2a1215;color:#fecaca}
    .notice.warn{border:1px solid #78350f;background:#271a0b;color:#fde68a}
    .results{margin-top:18px}
    .result-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
    .result-title{min-width:0}
    .result-title h4{margin:0;color:#f8fafc;font-size:1.15rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .result-title p{margin:3px 0 0;color:#94a3b8;font-size:.82rem}
    .result-actions{display:flex;gap:8px;flex:0 0 auto}
    .verdict{display:flex;align-items:center;gap:16px;margin-top:14px;padding:14px 16px;border:1px solid #1f2d4a;border-left:5px solid var(--verdict,#64748b);border-radius:12px;background:#101a2e}
    .verdict.pass{--verdict:#22c55e}.verdict.fail{--verdict:#ef4444}
    .verdict-badge{flex:0 0 auto;min-width:96px;padding:9px 14px;border-radius:9px;background:var(--verdict,#64748b);color:#fff;text-align:center;font-size:1.4rem;font-weight:800;letter-spacing:.06em}
    .verdict-caption{color:#94a3b8;font-size:.72rem;font-weight:600;overflow-wrap:anywhere}
    .verdict-main{color:#f8fafc;font-size:1.12rem;font-weight:700}
    .verdict-main span{color:#94a3b8;font-size:.86rem;font-weight:500}
    .verdict-detail{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:4px;color:#cbd5e1;font-size:.84rem}
    .verdict-detail b{color:#f8fafc}
    .metrics-table{width:100%;margin-top:14px;border-collapse:separate;border-spacing:0;border:1px solid #1f2d4a;border-radius:12px;overflow:hidden;font-variant-numeric:tabular-nums}
    .metrics-table th,.metrics-table td{padding:8px 14px;border-bottom:1px solid #1a2741;text-align:right;color:#dbeafe;font-size:.9rem}
    .metrics-table thead th{background:#111c31;color:#94a3b8;font-size:.7rem;text-transform:uppercase;letter-spacing:.06em}
    .metrics-table th:first-child{text-align:left}
    .metrics-table tbody th{color:#f8fafc;font-weight:600}
    .metrics-table tbody tr:last-child>*{border-bottom:0}
    .metrics-table td.avg{color:#fff;font-weight:700}
    .chart-sync-readout{position:sticky;top:78px;z-index:5;display:flex;align-items:center;gap:12px;min-height:48px;margin:14px 0 0;padding:8px 12px;border:1px solid #2b4266;border-radius:10px;background:#0a1425;color:#e2e8f0;box-sizing:border-box}
    .chart-sync-readout:not(.show)>*{opacity:.45}
    .readout-hint{color:#94a3b8;font-size:.78rem}
    .chart-sync-readout>strong{flex:0 0 auto;color:#f8fafc;font-size:.82rem}
    .sync-values{display:flex;flex-wrap:wrap;gap:6px}
    .sync-values span{padding:4px 7px;border:1px solid color-mix(in srgb,var(--sync-color) 65%,#334155);border-radius:999px;color:#dbeafe;background:color-mix(in srgb,var(--sync-color) 12%,#0f172a);font-size:.7rem;white-space:nowrap}
    .chart-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;margin-top:14px}
    .chart-card.wide .chart-frame{height:230px}
    .chart-card{padding:10px;border:1px solid #1f2d4a;border-radius:12px;background:#101a2e;cursor:zoom-in;transition:border-color .15s}
    .chart-card:hover{border-color:#38bdf8}
    .chart-title{margin-bottom:4px;color:#cbd5e1;font-size:.74rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
    .chart-frame{height:170px}
    .data-source{margin-top:16px;padding:10px 14px;border:1px solid #1f2d4a;border-radius:12px;background:#0d1729;color:#cbd5e1;font-size:.84rem}
    .data-source summary{cursor:pointer;color:#94a3b8;font-weight:600}
    .data-source dl{display:grid;grid-template-columns:max-content 1fr;gap:4px 16px;margin:10px 0 6px}
    .data-source dt{color:#94a3b8;font-weight:500}
    .data-source dd{margin:0;color:#e2e8f0;overflow-wrap:anywhere}
    .timeline-pointer-readout{position:absolute;z-index:3;display:grid;gap:5px;min-width:120px;max-width:260px;padding:7px 9px;border:1px solid #475569;border-radius:8px;background:rgba(2,6,23,.94);color:#f8fafc;box-shadow:0 8px 24px rgba(0,0,0,.4);pointer-events:none;opacity:0;transition:opacity .1s ease}
    .timeline-pointer-readout.show{opacity:1}
    .pointer-time{font-size:.75rem;font-weight:700;color:#e2e8f0}
    .pointer-badges{display:flex;flex-wrap:wrap;gap:4px}
    .pointer-badge{padding:2px 6px;border:1px solid currentColor;border-radius:999px;font-size:.68rem;font-weight:700;text-transform:uppercase;background:rgba(15,23,42,.9)}
    .pointer-overlap{font-size:.66rem;color:#fbbf24}
    .chart-modal{position:fixed;inset:0;z-index:100;padding:clamp(10px,2vw,28px);box-sizing:border-box;background:rgba(6,10,18,.82);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s ease}
    .chart-modal.show{opacity:1;pointer-events:auto}
    .chart-modal-body{box-sizing:border-box;background:#0b1324;border:1px solid #29405f;border-radius:12px;padding:14px;width:min(96vw,2200px);height:92vh;display:flex;flex-direction:column;box-shadow:0 30px 80px rgba(0,0,0,.6)}
    .chart-modal-header{display:flex;justify-content:space-between;align-items:center;color:#94a3b8;font-size:.8rem;margin-bottom:8px}
    .chart-modal-frame{position:relative;flex:1;background:#0a1120;border:1px solid #1f2d4a;border-radius:10px;padding:10px}
    .chart-modal-frame canvas{width:100%!important;height:100%!important}
    @@media(max-width:720px){.result-head{flex-direction:column}.verdict{flex-direction:column;align-items:flex-start}.metrics-table th,.metrics-table td{padding:7px 8px}}
</style>

@code {
    private static readonly (string Id, string Title)[] ChartCards =
    [
        ("chart-power", "TGP (W)"),
        ("chart-gpu", "GPU temperature (°C)"),
        ("chart-memory", "Memory temperature (°C)"),
        ("chart-gpc-clock", "GPC clock (MHz)"),
        ("chart-memory-clock", "Memory clock (MHz)"),
    ];

    private readonly AnalysisSettings _settings = new();
    private AnalysisSettingsBar? _settingsBar;
    private GpuMonLog? _log;
    private GpuMonAnalysis? _analysis;
    private string? _sourceName;
    private string? _pendingName;
    private string? _appliedPreset;
    private string? _error;
    private bool _isParsing;
    private bool _dragOver;
    private bool ShowChartModal { get; set; }
    private bool _chartsDirty;
    private bool _isExporting;

    private DateTime? TestDate => _analysis?.FirstInRangeTimestamp?.Date ?? _log?.StartTime?.Date;
    private string DurationDisplay => FormatSpan(_analysis?.InRangeSpan ?? TimeSpan.Zero);
    private string TgpCssClass => _analysis?.TgpCheck.Passed switch { true => "pass", false => "fail", _ => "na" };
    private IReadOnlyList<ActivitySummary> PStateSummary => _analysis?.PStateSummary ?? [];
    private IReadOnlyList<ActivitySummary> CappingSummary => _analysis?.CappingSummary ?? [];

    private IEnumerable<(string Label, MetricStats Stats)> MetricRows =>
    [
        ("TGP (W)", _analysis!.Tgp),
        ("GPU temperature (°C)", _analysis.GpuTemperature),
        ("Memory temperature (°C)", _analysis.MemoryTemperature),
        ("GPC clock (MHz)", _analysis.GpcClock),
        ("Memory clock (MHz)", _analysis.MemoryClock),
    ];

    private static IEnumerable<(string Label, string? Column)> ColumnRows(GpuMonColumns columns) =>
    [
        ("GPU utilization", columns.Utilization),
        ("TGP", columns.Tgp),
        ("GPU temperature", columns.GpuTemperature),
        ("Memory temperature", columns.MemoryTemperature),
        ("GPC clock", columns.GpcClock),
        ("Memory clock", columns.MemoryClock),
        ("P-State", columns.PState),
        ("Capping reason", columns.CappingReason),
    ];

    private static string FormatSpan(TimeSpan span) => span == TimeSpan.Zero
        ? ""
        : span.TotalHours >= 1 ? span.ToString(@"h\:mm\:ss") : span.ToString(@"m\:ss");

    private static string TimelineColor(string label) => label.ToLowerInvariant() switch
    {
        "pwr" => "#f59e0b",
        "thml" => "#ef4444",
        "vrel" => "#a855f7",
        "vop" => "#ec4899",
        "util" => "#38bdf8",
        "p0" => "#22c55e",
        "p2" => "#14b8a6",
        "p3" => "#3b82f6",
        "p4" => "#6366f1",
        "p5" => "#8b5cf6",
        "p8" => "#64748b",
        _ => "#94a3b8"
    };

    // Round half away from zero so displayed values match Excel (e.g. 83.195 -> 83.2).
    private static string Fmt(decimal? v) => v.HasValue ? Math.Round(v.Value, 2, MidpointRounding.AwayFromZero).ToString("0.##", CultureInfo.InvariantCulture) : "–";
    private static string Pct(decimal? v) => v.HasValue ? Math.Round(v.Value, 2, MidpointRounding.AwayFromZero).ToString("0.00", CultureInfo.InvariantCulture) + "%" : "n/a";

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _dragOver = false;
        _error = null;
        var file = e.File;
        if (!Path.GetExtension(file.Name).Equals(".csv", StringComparison.OrdinalIgnoreCase))
        {
            _error = $"'{file.Name}' is not a .csv file. Choose the GPUMON .csv log.";
            return;
        }

        _isParsing = true;
        _pendingName = file.Name;
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(50 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, true);
            var log = Analyzer.Parse(await reader.ReadToEndAsync());
            _appliedPreset = _settingsBar is null ? null : await _settingsBar.ApplyForFileAsync(file.Name);
            _log = log;
            _sourceName = file.Name;
            Reanalyze();
        }
        catch (IOException ex) when (ex.Message.Contains("length", StringComparison.OrdinalIgnoreCase))
        {
            _error = $"'{file.Name}' is larger than 50 MB.";
        }
        catch (Exception ex)
        {
            _error = $"Could not read '{file.Name}': {ex.Message}";
        }
        finally
        {
            _isParsing = false;
        }
    }

    private void OnSettingsChanged(SettingsChange change)
    {
        if (_analysis is null) return;
        if (change == SettingsChange.Tgp)
        {
            _analysis.TgpCheck = GpuMonLogAnalyzer.EvaluateTgp(_analysis.InRangeSamples, _settings.ExpectedTgpWatts, _settings.RequiredTgpPercent);
            _ = RenderTgpChartAsync();
            return;
        }
        Reanalyze();
    }

    private void Reanalyze()
    {
        if (_log is null) return;
        _analysis = Analyzer.Analyze(_log, _settings.UtilizationMin, _settings.UtilizationMax, _settings.ExpectedTgpWatts, _settings.RequiredTgpPercent);
        _chartsDirty = true;
    }

    private string SettingsLine(TgpCheckResult check)
        => $"GPU utilization {_analysis!.UtilizationRange} · Expected TGP {Fmt(check.ExpectedWatts)} W · Pass if >= {Fmt(check.RequiredPercent)}% of samples" +
           (_settings.PresetName is null ? "" : $" · Preset: {_settings.PresetName}");

    private Task<string> GetSummaryClipboardAsync()
    {
        if (_analysis is null || _log is null) return Task.FromResult(string.Empty);
        var a = _analysis;
        var check = a.TgpCheck;
        var sb = new StringBuilder();
        sb.AppendLine($"File: {_sourceName}");
        sb.AppendLine($"Settings: {SettingsLine(check)}");
        sb.AppendLine($"TGP check: {check.Verdict} - {Pct(check.PercentAtOrAbove)} of {check.SampleCount:N0} in-range samples >= {Fmt(check.ExpectedWatts)} W (required {Fmt(check.RequiredPercent)}%)" +
                      (check.PassingTgpWatts is null ? "" : $"; would pass up to {Fmt(check.PassingTgpWatts)} W"));
        if (a.ReliabilityWarning is { } warning) sb.AppendLine($"Warning: {warning}");
        sb.AppendLine($"Samples in range: {a.InRangeSamples.Count}/{_log.Samples.Count} ({a.CoveragePercent:0.#}%)");
        foreach (var (label, stats) in MetricRows)
            sb.AppendLine($"{label}  Min={Fmt(stats.Minimum)}  Avg={Fmt(stats.Average)}  Max={Fmt(stats.Maximum)}");
        sb.AppendLine($"GPU: {_log.BrandName}  VBIOS: {_log.VbiosVersion}  Driver: {_log.DriverVersion}");
        sb.AppendLine($"Date: {TestDate:yyyy-MM-dd}  Duration: {DurationDisplay}");
        return Task.FromResult(sb.ToString());
    }

    private async Task RenderTgpChartAsync()
    {
        if (_analysis is null || _analysis.InRangeSamples.Count == 0) return;
        try
        {
            var samples = _analysis.InRangeSamples;
            await JS.InvokeVoidAsync("gpuCharts.renderLine", "chart-power", Labels(samples), samples.Select(s => s.TgpWatts).ToArray(), "TGP (W)", "#22c55e", _settings.ExpectedTgpWatts);
            await JS.InvokeVoidAsync("gpuCharts.createMainSyncGroup", "main-performance", SyncedCharts, "main-chart-sync-readout");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "TGP chart rendering failed.");
        }
    }

    private static readonly string[] SyncedCharts = ["chart-power", "chart-gpu", "chart-memory", "chart-gpc-clock", "chart-memory-clock"];

    [SupplyParameterFromQuery(Name = "log")] public Guid? HandoffId { get; set; }
    private bool _applyPresetAfterHandoff;

    protected override void OnInitialized()
    {
        if (HandoffId is not { } id || Handoff.Get(id) is not { } handoff) return;
        _log = handoff.Log;
        _sourceName = handoff.FileName;
        _applyPresetAfterHandoff = true;
        Reanalyze();
    }

    private static string[] Labels(IReadOnlyList<GpuMonSample> samples)
        => samples.Select(s => s.Timestamp?.ToString("HH:mm:ss") ?? $"#{s.Index + 1}").ToArray();

    private async Task RenderChartsAsync()
    {
        if (_analysis is null) return;
        try
        {
            var samples = _analysis.InRangeSamples;
            if (samples.Count > 0)
            {
                var labels = Labels(samples);

                await JS.InvokeVoidAsync("gpuCharts.renderLine", "chart-power", labels, samples.Select(s => s.TgpWatts).ToArray(), "TGP (W)", "#22c55e", _settings.ExpectedTgpWatts);
                await JS.InvokeVoidAsync("gpuCharts.renderLine", "chart-gpu", labels, samples.Select(s => s.GpuTemperature).ToArray(), "GPU temperature (°C)", "#3b82f6");
                await JS.InvokeVoidAsync("gpuCharts.renderLine", "chart-memory", labels, samples.Select(s => s.MemoryTemperature).ToArray(), "Memory temperature (°C)", "#f97316");
                await JS.InvokeVoidAsync("gpuCharts.renderLine", "chart-gpc-clock", labels, samples.Select(s => s.GpcClock).ToArray(), "GPC clock (MHz)", "#06b6d4");
                await JS.InvokeVoidAsync("gpuCharts.renderLine", "chart-memory-clock", labels, samples.Select(s => s.MemoryClock).ToArray(), "Memory clock (MHz)", "#eab308");
                await JS.InvokeVoidAsync("gpuCharts.createMainSyncGroup", "main-performance", SyncedCharts, "main-chart-sync-readout");
            }

            if (_analysis.PStateTimeline.Count > 0)
                await JS.InvokeVoidAsync("gpuCharts.renderTimeline", "chart-pstate-timeline", _analysis.PStateTimeline, "P-State", _analysis.InRangeWindows);

            if (_analysis.CappingTimeline.Count > 0)
                await JS.InvokeVoidAsync("gpuCharts.renderTimeline", "chart-capping-timeline", _analysis.CappingTimeline, "Capping Reason", _analysis.InRangeWindows);
        }
        catch (Exception ex)
        {
            // Charts are optional if Chart.js is unavailable.
            Logger.LogWarning(ex, "Chart rendering failed.");
        }
    }

    private async Task OpenChartModalAsync(string sourceId)
    {
        ShowChartModal = true;
        StateHasChanged();
        await Task.Delay(30); // allow modal canvas to render
        try
        {
            await JS.InvokeVoidAsync("gpuCharts.openModalFrom", "chart-modal-canvas", sourceId);
        }
        catch { }
    }

    private async Task ControlTimelineAsync((string ChartId, string Command) request)
    {
        try
        {
            await JS.InvokeVoidAsync("gpuCharts.timelineCommand", request.ChartId, request.Command);
        }
        catch
        {
            // Timeline controls are optional if chart rendering is unavailable.
        }
    }

    private async Task CloseChartModal()
    {
        ShowChartModal = false;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("gpuCharts.destroy", "chart-modal-canvas"); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_applyPresetAfterHandoff && _settingsBar is not null && _sourceName is not null)
        {
            _applyPresetAfterHandoff = false;
            _appliedPreset = await _settingsBar.ApplyForFileAsync(_sourceName);
            Reanalyze();
            StateHasChanged();
            return;
        }
        if (_chartsDirty && _analysis is not null)
        {
            _chartsDirty = false;
            await RenderChartsAsync();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ExportPdfAsync()
    {
        if (_isExporting || _analysis is null || _log is null) return;
        _isExporting = true;
        _error = null;
        try
        {
            var a = _analysis;
            var tgp = a.TgpCheck;
            var report = new
            {
                SourceFile = _sourceName ?? "",
                Settings = SettingsLine(tgp),
                Warning = a.ReliabilityWarning,
                ToolVersion = _log.ToolVersion,
                Date = TestDate?.ToString("yyyy-MM-dd") ?? "",
                Duration = DurationDisplay,
                Coverage = $"{a.CoveragePercent.ToString("0.0", CultureInfo.InvariantCulture)}%",
                MatchingRows = a.InRangeSamples.Count,
                TotalRows = _log.Samples.Count,
                Filter = a.UtilizationRange,
                GpuTjMin = Fmt(a.GpuTemperature.Minimum),
                GpuTjAvg = Fmt(a.GpuTemperature.Average),
                GpuTjMax = Fmt(a.GpuTemperature.Maximum),
                MemTjMin = Fmt(a.MemoryTemperature.Minimum),
                MemTjAvg = Fmt(a.MemoryTemperature.Average),
                MemTjMax = Fmt(a.MemoryTemperature.Maximum),
                GpcClockMin = Fmt(a.GpcClock.Minimum),
                GpcClockAvg = Fmt(a.GpcClock.Average),
                GpcClockMax = Fmt(a.GpcClock.Maximum),
                MemoryClockMin = Fmt(a.MemoryClock.Minimum),
                MemoryClockAvg = Fmt(a.MemoryClock.Average),
                MemoryClockMax = Fmt(a.MemoryClock.Maximum),
                PowerMin = Fmt(a.Tgp.Minimum),
                PowerAvg = Fmt(a.Tgp.Average),
                PowerMax = Fmt(a.Tgp.Maximum),
                TgpVerdict = tgp.Verdict,
                TgpExpected = Fmt(tgp.ExpectedWatts),
                TgpRequired = Fmt(tgp.RequiredPercent),
                TgpPercent = Pct(tgp.PercentAtOrAbove),
                TgpAtOrAbove = tgp.SamplesAtOrAbove,
                TgpSamples = tgp.SampleCount,
                TgpPassingWatts = tgp.PassingTgpWatts is null ? "" : $"{Fmt(tgp.PassingTgpWatts)} W",
                TgpSamplesShort = tgp.SamplesShort,
                BrandName = _log.BrandName,
                VbiosVersion = _log.VbiosVersion,
                DriverVersion = _log.DriverVersion,
                UtilColumn = _log.Columns.Utilization,
                PowerColumn = _log.Columns.Tgp ?? "not found",
                CappingSamples = CappingSummary.Sum(item => item.InRangeSamples),
                CappingPeriods = CappingSummary.Sum(item => item.InRangePeriods),
                PStateSamples = PStateSummary.Sum(item => item.InRangeSamples),
                PStatePeriods = PStateSummary.Sum(item => item.InRangePeriods)
            };

            var pStates = PStateSummary
                .Where(item => item.InRangeSamples > 0)
                .Select(item => new { State = item.Label, Samples = item.InRangeSamples, Periods = item.InRangePeriods })
                .ToList();

            var capping = CappingSummary
                .Where(item => item.InRangeSamples > 0)
                .Select(item => new { Reason = GpuMonLogAnalyzer.CappingReasonDisplay(item.Label), Samples = item.InRangeSamples, Periods = item.InRangePeriods })
                .ToList();

            var baseName = Path.GetFileNameWithoutExtension(_sourceName ?? "gpu-log");
            await JS.InvokeVoidAsync("gpuExport.exportEngineeringPdf", report, pStates, capping, $"{baseName}-report-{DateTime.Now:yyyyMMdd-HHmm}.pdf");
        }
        catch (Exception ex)
        {
            _error = $"PDF export failed: {ex.Message}";
        }
        finally
        {
            _isExporting = false;
        }
    }
}
