</style>

@code {
    private static readonly string[] RunColors = ["#3b82f6", "#f97316", "#22c55e", "#a855f7"];
    private static readonly MetricDefinition[] ComparisonMetrics =
    [
        new("GPU temperature", "°C", run => run.GpuTemperature),
        new("Memory temperature", "°C", run => run.MemoryTemperature),
        new("Power", "W", run => run.Power),
        new("GPC clock", "MHz", run => run.GpcClock),
        new("Memory clock", "MHz", run => run.MemoryClock),
    ];
    private readonly List<RunSlot> _runs = [new("Run A"), new("Run B")];
    private List<ComparisonRunResult> _results = [];
    private int _utilizationMin = 99;
    private int _utilizationMax = 100;
    private bool _isComparing;
    private bool _chartsDirty;
    private int ReadyRunCount => _runs.Count(run => run.Content is not null);
    private string _normalizedRange => $"{Math.Clamp(Math.Min(_utilizationMin, _utilizationMax), 0, 100)}-{Math.Clamp(Math.Max(_utilizationMin, _utilizationMax), 0, 100)}%";

    private sealed class RunSlot(string name)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Name { get; set; } = name;
        public string? FileName { get; set; }
        public string? Content { get; set; }
        public string? Error { get; set; }
    }

    private sealed record MetricDefinition(string Label, string Unit, Func<ComparisonRunResult, ComparisonMetric> Select);

    private void AddRun() => _runs.Add(new($"Run {(char)('A' + _runs.Count)}"));
    private void RemoveRun(int index) { if (_runs.Count > 2) { _runs.RemoveAt(index); _results = []; } }

    private async Task SelectFileAsync(int index, InputFileChangeEventArgs args)
    {
        var slot = _runs[index];
        try
        {
            var file = args.File;
            if (!Path.GetExtension(file.Name).Equals(".csv", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("Please upload a .csv file.");
            using var stream = file.OpenReadStream(50 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, true);
            slot.Content = await reader.ReadToEndAsync();
            slot.FileName = file.Name;
            slot.Error = null;
        }
        catch (Exception exception)
        {
            slot.Content = null;
            slot.Error = exception.Message;
        }
    }

    private Task CompareAsync()
    {
        _isComparing = true;
        var parsed = new List<ComparisonRunResult>();
        foreach (var slot in _runs.Where(run => run.Content is not null))
        {
            try
            {
                slot.Error = null;
                parsed.Add(ComparisonParser.Parse(slot.Content!, slot.FileName ?? slot.Name, slot.Name, _utilizationMin, _utilizationMax));
            }
            catch (Exception exception)
            {
                slot.Error = exception.Message;
            }
        }
        _results = parsed.Count >= 2 ? parsed : [];
        _chartsDirty = _results.Count >= 2;
        _isComparing = false;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartsDirty)
        {
            _chartsDirty = false;
            var payload = _results.Select((run, index) => new
            {
                run.Name,
                Color = RunColors[index],
                Samples = run.Samples,
                CappingSegments = run.CappingSegments
            }).ToArray();
            await JS.InvokeVoidAsync("gpuCharts.renderComparison", new object?[] { payload });
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private static string Fmt(decimal? value) => value?.ToString("0.##") ?? "-";
}
