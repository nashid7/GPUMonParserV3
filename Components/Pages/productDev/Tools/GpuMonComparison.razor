    .compare-controls{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.utilization-setting{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.compare-controls label{font-size:.82rem;color:#cbd5e1}.compare-controls input{width:70px;padding:5px 8px;border:1px solid #334766;border-radius:7px;background:#0a1323;color:#f8fafc}.add-run-button{margin-left:auto}.run-upload-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;margin-top:15px}.run-upload-card{padding:13px;border:1px solid #263a59;border-top:3px solid var(--run-color);border-radius:10px;background:#101b30}.run-card-head{display:flex;gap:8px;align-items:center;margin-bottom:10px}.run-name{min-width:0;flex:1;border:0;border-bottom:1px solid #334766;background:transparent;color:#fff;font-weight:700;padding:3px}.remove-run{border:0;background:transparent;color:#94a3b8;font-size:1.2rem}.file-state{margin-top:9px;font-size:.72rem;color:#94a3b8;overflow-wrap:anywhere}.file-state.ready{color:#86efac}.run-error{margin-top:7px;color:#fca5a5;font-size:.72rem}.compare-submit-row{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:16px;padding:14px 16px;border:1px solid #2b4162;border-radius:10px;background:#101c31}.compare-readiness strong,.compare-readiness span{display:block}.compare-readiness strong{color:#f8fafc;font-size:.86rem}.compare-readiness span{margin-top:3px;color:#8da0ba;font-size:.7rem}.compare-submit-button{min-width:190px;padding:9px 22px;font-weight:700;box-shadow:0 6px 18px rgba(37,99,235,.25)}.compare-submit-button:not(:disabled){background:#2563eb;border-color:#3b82f6}.compare-submit-button:not(:disabled):hover{background:#1d4ed8}
    .comparison-table-wrap{overflow:auto;margin:16px 0 18px;border:1px solid #2a4164;border-radius:12px;background:#0a1425}.comparison-table{width:100%;min-width:760px;border-collapse:separate;border-spacing:0;table-layout:fixed}.comparison-table th,.comparison-table td{padding:13px;border-right:1px solid #233653;border-bottom:1px solid #233653}.comparison-table tr>*:last-child{border-right:0}.comparison-table tbody tr:last-child>*{border-bottom:0}.comparison-table thead th{background:#142139;color:#f8fafc;text-align:left;vertical-align:top}.comparison-table .metric-column{width:170px;color:#94a3b8;text-transform:uppercase;font-size:.68rem;letter-spacing:.07em}.run-key{display:flex;align-items:center;gap:7px;font-size:.86rem;font-weight:700}.run-key:before{content:"";flex:0 0 auto;width:9px;height:9px;border-radius:50%;background:var(--run-color);box-shadow:0 0 0 3px color-mix(in srgb,var(--run-color) 18%,transparent)}.run-file{display:block;margin:5px 0 0 16px;color:#8293aa;font-size:.66rem;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.metric-name{background:#101c31;color:#f8fafc;text-align:left}.metric-name strong{display:block;font-size:.8rem}.metric-name span{display:block;margin-top:3px;color:#7dd3fc;font-size:.67rem;font-weight:500}.metric-value-grid{display:grid;grid-template-columns:repeat(3,minmax(58px,1fr));gap:6px}.metric-value-grid>div{min-width:0;padding:7px 6px;border:1px solid #263b5b;border-radius:7px;background:#0d192b;text-align:center}.metric-value-grid span{display:block;margin-bottom:3px;color:#7f90a8;text-transform:uppercase;font-size:.57rem;font-weight:700;letter-spacing:.05em}.metric-value-grid strong{display:block;color:#dbeafe;font-size:.78rem;font-variant-numeric:tabular-nums}.metric-value-grid .average{border-color:#315a86;background:#10243b}.metric-value-grid .average span{color:#7dd3fc}.metric-value-grid .average strong{color:#fff;font-size:.86rem}
    .comparison-chart-card{margin-top:13px;padding:14px;border:1px solid #263a59;border-radius:12px;background:#0a1425}.comparison-chart-card>div:first-child{display:flex;justify-content:space-between;gap:12px;align-items:center}.comparison-chart-card>div:first-child span{font-size:.7rem;color:#8293aa}.comparison-chart-frame{height:330px;margin-top:9px}.comparison-chart-frame.capping{height:360px}.comparison-chart-frame canvas{width:100%!important;height:100%!important}
