@page "/productDev/Tools/gpuMonComparison"
@using System.Text
@using par.Services
@inject GpuComparisonParser ComparisonParser
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>GPU Log Comparison</PageTitle>

<div class="compare-heading">
    <div>
        <p class="eyebrow">Multi-run analysis</p>
        <h3>Performance comparison</h3>
        <p class="muted">Upload two to four GPU Monitor CSV files and compare their performance over the same elapsed timeline.</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" href="/productDev/Tools/gpuMonLogParser">Single-run analysis</a>
</div>

<section class="compare-panel">
    <div class="compare-controls">
        <div class="utilization-setting">
            <label>Shared utilization range</label>
            <input type="number" min="0" max="100" @bind="_utilizationMin" />
            <span>to</span>
            <input type="number" min="0" max="100" @bind="_utilizationMax" />
        </div>
        @if (_runs.Count < 4)
        {
            <button class="btn btn-outline-secondary btn-sm add-run-button" @onclick="AddRun">+ Add another run</button>
        }
    </div>

    <div class="run-upload-grid">
        @for (var index = 0; index < _runs.Count; index++)
        {
            var slotIndex = index;
            var slot = _runs[index];
            <div class="run-upload-card" style="@($"--run-color:{RunColors[index]}")" @key="slot.Id">
                <div class="run-card-head">
                    <input class="run-name" @bind="slot.Name" aria-label="Run name" />
                    @if (_runs.Count > 2)
                    {
                        <button class="remove-run" title="Remove run" @onclick="(() => RemoveRun(slotIndex))">×</button>
                    }
                </div>
                <InputFile OnChange="@(args => SelectFileAsync(slotIndex, args))" accept=".csv,text/csv" />
                <div class="file-state @(slot.Content is not null ? "ready" : "")">@(slot.FileName ?? "Upload a GPU Monitor CSV")</div>
                @if (!string.IsNullOrWhiteSpace(slot.Error))
                {
                    <div class="run-error">@slot.Error</div>
                }
            </div>
        }
    </div>

    <div class="compare-submit-row">
        <div class="compare-readiness" aria-live="polite">
            @if (ReadyRunCount >= 2)
            {
                <strong>Ready to compare</strong>
                <span>@ReadyRunCount CSV @(ReadyRunCount == 1 ? "file" : "files") selected</span>
            }
            else
            {
                <strong>Select at least two CSV files</strong>
                <span>@ReadyRunCount of 2 required files selected</span>
            }
        </div>
        <button class="btn btn-primary compare-submit-button" @onclick="CompareAsync" disabled="@(_isComparing || ReadyRunCount < 2)">
            @(_isComparing ? "Comparing..." : ReadyRunCount >= 2 ? $"Compare {ReadyRunCount} runs" : "Compare selected runs")
        </button>
    </div>
</section>

@if (_results.Count >= 2)
{
    <section class="compare-panel results">
        <div class="section-head">
            <div>
                <p class="eyebrow">Comparison summary</p>
                <h4>Performance overview</h4>
                <p class="muted">Each row compares the same metric across every run. Average is emphasized; all values use the shared @_normalizedRange utilization range.</p>
            </div>
        </div>

        <div class="comparison-table-wrap">
            <table class="comparison-table">
                <thead>
                    <tr>
                        <th class="metric-column">Metric</th>
                        @for (var index = 0; index < _results.Count; index++)
                        {
                            var result = _results[index];
                            <th>
                                <span class="run-key" style="@($"--run-color:{RunColors[index]}")">@result.Name</span>
                                <span class="run-file">@result.SourceFile</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var definition in ComparisonMetrics)
                    {
                        <tr>
                            <th scope="row" class="metric-name"><strong>@definition.Label</strong><span>@definition.Unit</span></th>
                            @foreach (var result in _results)
                            {
                                var metric = definition.Select(result);
                                <td>
                                    <div class="metric-value-grid">
                                        <div><span>Min</span><strong>@Fmt(metric.Minimum)</strong></div>
                                        <div class="average"><span>Average</span><strong>@Fmt(metric.Average)</strong></div>
                                        <div><span>Max</span><strong>@Fmt(metric.Maximum)</strong></div>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="comparison-chart-card">
            <div><p class="eyebrow">GPU temperature</p><span>Filtered samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-gpu-temperature"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">Memory temperature</p><span>Filtered samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-memory-temperature"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">Power</p><span>Filtered samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-power"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">GPC clock</p><span>Filtered samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-gpc-clock"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">Memory clock</p><span>Filtered samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-memory-clock"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">Capping reasons</p><span>Every active reason and overlap across the complete test</span></div>
            <div class="comparison-chart-frame capping"><canvas id="comparison-capping"></canvas></div>
        </div>
    </section>
}

<style>
