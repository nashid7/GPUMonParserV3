@page "/productDev/Tools/gpuMonComparison"
@using System.Globalization
@using System.Text
@using par.Services
@inject GpuMonLogAnalyzer Analyzer
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>GPU Log Comparison</PageTitle>

<div class="compare-heading">
    <h3>Compare runs</h3>
    <p class="muted">Add two to four GPUMON logs. Results update automatically and use the same settings for every run.</p>
</div>

<div class="compare-settings">
    <AnalysisSettingsBar Settings="_settings" OnChanged="OnSettingsChanged" />
</div>

<section class="compare-panel">
    <div class="run-upload-grid">
        @for (var index = 0; index < _runs.Count; index++)
        {
            var slotIndex = index;
            var slot = _runs[index];
            <div class="run-upload-card" style="@($"--run-color:{RunColors[index]}")" @key="slot.Id">
                <div class="run-card-head">
                    <input class="run-name" @bind="slot.Name" @bind:after="Recompare" aria-label="Run name" />
                    @if (_runs.Count > 2)
                    {
                        <button class="remove-run" title="Remove run" @onclick="(() => RemoveRun(slotIndex))">×</button>
                    }
                </div>
                <div class="run-drop @(slot.Log is not null ? "ready" : "")">
                    <InputFile OnChange="@(args => SelectFileAsync(slotIndex, args))" accept=".csv,text/csv" class="run-drop-input" title="Choose a GPUMON .csv file" />
                    <span>@(slot.FileName ?? "Drop a GPUMON .csv or click")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(slot.Error))
                {
                    <div class="run-error">@slot.Error</div>
                }
            </div>
        }
        @if (_runs.Count < 4)
        {
            <button class="add-run-card" @onclick="AddRun">+ Add run</button>
        }
    </div>
    @if (_results.Count < 2)
    {
        <p class="compare-hint">@(ReadyRunCount == 0 ? "Add at least two logs to compare." : "Add one more log to compare.")</p>
    }
</section>

@if (_results.Count >= 2)
{
    <section class="compare-panel results">
        <div class="section-head">
            <div>
                <h4>Results</h4>
                <p class="muted">GPU utilization @_settings.UtilizationRange · Expected TGP @Fmt(_settings.ExpectedTgpWatts) W · Pass if ≥ @Fmt(_settings.RequiredTgpPercent)% of samples</p>
            </div>
        </div>

        <div class="comparison-table-wrap">
            <table class="comparison-table">
                <thead>
                    <tr>
                        <th class="metric-column">Metric</th>
                        @for (var index = 0; index < _results.Count; index++)
                        {
                            var result = _results[index];
                            <th>
                                <span class="run-key" style="@($"--run-color:{result.Color}")">@result.Name</span>
                                <span class="run-file" title="@result.SourceFile">@result.SourceFile</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row" class="metric-name"><strong>TGP check</strong><span>≥ @Fmt(_settings.ExpectedTgpWatts) W in ≥ @Fmt(_settings.RequiredTgpPercent)%</span></th>
                        @foreach (var result in _results)
                        {
                            var check = result.Analysis.TgpCheck;
                            <td>
                                <div class="tgp-cell @(check.Passed switch { true => "pass", false => "fail", _ => "na" })">
                                    <strong>@check.Verdict</strong>
                                    <span>
                                        @Pct(check.PercentAtOrAbove) · @check.SamplesAtOrAbove.ToString("N0")/@check.SampleCount.ToString("N0")
                                        @if (check.PassingTgpWatts is not null)
                                        {
                                            <small>passes up to @Fmt(check.PassingTgpWatts) W</small>
                                        }
                                    </span>
                                </div>
                                @if (result.Analysis.ReliabilityWarning is not null)
                                {
                                    <div class="cell-warning" title="@result.Analysis.ReliabilityWarning">Only @result.Analysis.InRangeSamples.Count samples in range</div>
                                }
                            </td>
                        }
                    </tr>
                    @foreach (var definition in ComparisonMetrics)
                    {
                        <tr>
                            <th scope="row" class="metric-name"><strong>@definition.Label</strong><span>@definition.Unit</span></th>
                            @foreach (var result in _results)
                            {
                                var metric = definition.Select(result.Analysis);
                                <td>
                                    <div class="metric-value-grid">
                                        <div><span>Min</span><strong>@Fmt(metric.Minimum)</strong></div>
                                        <div class="average"><span>Average</span><strong>@Fmt(metric.Average)</strong></div>
                                        <div><span>Max</span><strong>@Fmt(metric.Maximum)</strong></div>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="comparison-chart-card">
            <div><p class="eyebrow">TGP (W)</p><span>In-range samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-power"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">GPU temperature (°C)</p><span>In-range samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-gpu-temperature"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">Memory temperature (°C)</p><span>In-range samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-memory-temperature"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">GPC clock (MHz)</p><span>In-range samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-gpc-clock"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">Memory clock (MHz)</p><span>In-range samples aligned by elapsed test time</span></div>
            <div class="comparison-chart-frame"><canvas id="comparison-memory-clock"></canvas></div>
        </div>
        <div class="comparison-chart-card">
            <div><p class="eyebrow">Capping reasons</p><span>Active reasons while GPU utilization is within @_settings.UtilizationRange</span></div>
            <div class="comparison-chart-frame capping"><canvas id="comparison-capping"></canvas></div>
        </div>
    </section>
}

<style>
    .compare-heading h3,.section-head h4{margin:0 0 4px;color:#f8fafc}.eyebrow{margin:0;color:#7dd3fc;text-transform:uppercase;font-size:.68rem;font-weight:700;letter-spacing:.08em}.muted{color:#94a3b8;font-size:.88rem}
    .compare-settings{margin-top:14px}
    .compare-panel{margin-top:14px;padding:16px;border:1px solid #223252;border-radius:14px;background:#0d1729}
    .run-upload-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
    .run-upload-card{padding:12px;border:1px solid #263a59;border-top:3px solid var(--run-color);border-radius:10px;background:#101b30}
    .run-card-head{display:flex;gap:8px;align-items:center;margin-bottom:8px}
    .run-name{min-width:0;flex:1;border:0;border-bottom:1px solid #334766;background:transparent;color:#fff;font-weight:700;padding:3px}
    .remove-run{border:0;background:transparent;color:#94a3b8;font-size:1.2rem}
    .run-drop{position:relative;display:flex;align-items:center;justify-content:center;min-height:54px;padding:8px;border:1.5px dashed #36527c;border-radius:9px;color:#94a3b8;font-size:.76rem;text-align:center;overflow-wrap:anywhere}
    .run-drop:hover{border-color:#38bdf8}
    .run-drop.ready{border-style:solid;border-color:#166534;color:#86efac}
    .run-drop-input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
    .run-drop span{pointer-events:none}
    .run-error{margin-top:7px;color:#fca5a5;font-size:.72rem}
    .add-run-card{min-height:110px;border:1.5px dashed #2b4162;border-radius:10px;background:transparent;color:#7dd3fc;font-size:.86rem}
    .add-run-card:hover{border-color:#38bdf8;background:#0f1d33}
    .compare-hint{margin:12px 0 0;color:#94a3b8;font-size:.84rem}
    .comparison-table-wrap{overflow:auto;margin:14px 0 16px;border:1px solid #2a4164;border-radius:12px;background:#0a1425}.comparison-table{width:100%;min-width:760px;border-collapse:separate;border-spacing:0;table-layout:fixed}.comparison-table th,.comparison-table td{padding:12px;border-right:1px solid #233653;border-bottom:1px solid #233653}.comparison-table tr>*:last-child{border-right:0}.comparison-table tbody tr:last-child>*{border-bottom:0}.comparison-table thead th{background:#142139;color:#f8fafc;text-align:left;vertical-align:top}.comparison-table .metric-column{width:170px;color:#94a3b8;text-transform:uppercase;font-size:.68rem;letter-spacing:.07em}.run-key{display:flex;align-items:center;gap:7px;font-size:.86rem;font-weight:700}.run-key:before{content:"";flex:0 0 auto;width:9px;height:9px;border-radius:50%;background:var(--run-color)}.run-file{display:block;margin:5px 0 0 16px;color:#8293aa;font-size:.66rem;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.metric-name{background:#101c31;color:#f8fafc;text-align:left}.metric-name strong{display:block;font-size:.8rem}.metric-name span{display:block;margin-top:3px;color:#7dd3fc;font-size:.67rem;font-weight:500}.metric-value-grid{display:grid;grid-template-columns:repeat(3,minmax(58px,1fr));gap:6px}.metric-value-grid>div{min-width:0;padding:6px;border:1px solid #263b5b;border-radius:7px;background:#0d192b;text-align:center}.metric-value-grid span{display:block;margin-bottom:3px;color:#7f90a8;text-transform:uppercase;font-size:.57rem;font-weight:700;letter-spacing:.05em}.metric-value-grid strong{display:block;color:#dbeafe;font-size:.78rem;font-variant-numeric:tabular-nums}.metric-value-grid .average{border-color:#315a86;background:#10243b}.metric-value-grid .average span{color:#7dd3fc}.metric-value-grid .average strong{color:#fff;font-size:.86rem}
    .tgp-cell{display:flex;align-items:center;gap:10px;padding:7px 9px;border:1px solid #263b5b;border-left:4px solid var(--tgp-color,#64748b);border-radius:7px;background:#0d192b}.tgp-cell.pass{--tgp-color:#22c55e}.tgp-cell.fail{--tgp-color:#ef4444}.tgp-cell strong{padding:3px 9px;border-radius:5px;background:var(--tgp-color,#64748b);color:#fff;font-size:.8rem;letter-spacing:.05em}.tgp-cell span{color:#dbeafe;font-size:.72rem;font-variant-numeric:tabular-nums}.tgp-cell small{display:block;color:#94a3b8;font-size:.66rem}
    .cell-warning{margin-top:5px;color:#fde68a;font-size:.68rem}
    .comparison-chart-card{margin-top:12px;padding:14px;border:1px solid #263a59;border-radius:12px;background:#0a1425}.comparison-chart-card>div:first-child{display:flex;justify-content:space-between;gap:12px;align-items:center}.comparison-chart-card>div:first-child span{font-size:.7rem;color:#8293aa}.comparison-chart-frame{height:300px;margin-top:9px}.comparison-chart-frame.capping{height:340px}.comparison-chart-frame canvas{width:100%!important;height:100%!important}
    @@media(max-width:700px){.comparison-chart-card>div:first-child{display:block}.comparison-table{min-width:680px}.comparison-table .metric-column{width:140px}}
</style>

@code {
    private static readonly string[] RunColors = ["#3b82f6", "#f97316", "#22c55e", "#a855f7"];
    private static readonly MetricDefinition[] ComparisonMetrics =
    [
        new("TGP", "W", analysis => analysis.Tgp),
        new("GPU temperature", "°C", analysis => analysis.GpuTemperature),
        new("Memory temperature", "°C", analysis => analysis.MemoryTemperature),
        new("GPC clock", "MHz", analysis => analysis.GpcClock),
        new("Memory clock", "MHz", analysis => analysis.MemoryClock),
    ];
    private readonly AnalysisSettings _settings = new();
    private readonly List<RunSlot> _runs = [new("Run A"), new("Run B")];
    private List<RunResult> _results = [];
    private bool _chartsDirty;
    private int ReadyRunCount => _runs.Count(run => run.Log is not null);

    private sealed class RunSlot(string name)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Name { get; set; } = name;
        public string? FileName { get; set; }
        public GpuMonLog? Log { get; set; }
        public string? Error { get; set; }
    }

    private sealed record RunResult(string Name, string SourceFile, GpuMonAnalysis Analysis, string Color);

    private sealed record MetricDefinition(string Label, string Unit, Func<GpuMonAnalysis, MetricStats> Select);

    private void AddRun() => _runs.Add(new($"Run {(char)('A' + _runs.Count)}"));

    private void RemoveRun(int index)
    {
        if (_runs.Count <= 2) return;
        _runs.RemoveAt(index);
        Recompare();
    }

    private async Task SelectFileAsync(int index, InputFileChangeEventArgs args)
    {
        var slot = _runs[index];
        var file = args.File;
        slot.Error = null;
        try
        {
            if (!Path.GetExtension(file.Name).Equals(".csv", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException($"'{file.Name}' is not a .csv file.");
            await using var stream = file.OpenReadStream(50 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, true);
            slot.Log = Analyzer.Parse(await reader.ReadToEndAsync());
            slot.FileName = file.Name;
        }
        catch (Exception exception)
        {
            slot.Log = null;
            slot.FileName = null;
            slot.Error = exception.Message;
        }
        Recompare();
    }

    private void OnSettingsChanged(SettingsChange change) => Recompare();

    // Re-runs the analysis for every loaded log; shows results once at least two runs have in-range samples.
    private void Recompare()
    {
        var results = new List<RunResult>();
        foreach (var slot in _runs.Where(run => run.Log is not null))
        {
            var analysis = Analyzer.Analyze(slot.Log!, _settings.UtilizationMin, _settings.UtilizationMax, _settings.ExpectedTgpWatts, _settings.RequiredTgpPercent);
            if (analysis.InRangeSamples.Count == 0)
            {
                slot.Error = $"No samples are within {analysis.UtilizationRange} GPU utilization.";
                continue;
            }
            if (slot.Error?.StartsWith("No samples are within", StringComparison.Ordinal) == true) slot.Error = null;
            results.Add(new RunResult(slot.Name, slot.FileName ?? slot.Name, analysis, RunColors[_runs.IndexOf(slot)]));
        }
        _results = results.Count >= 2 ? results : [];
        _chartsDirty = _results.Count >= 2;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartsDirty)
        {
            _chartsDirty = false;
            var payload = _results.Select(run => new
            {
                run.Name,
                run.Color,
                Samples = run.Analysis.InRangeSamples.Select(sample => new
                {
                    sample.ElapsedSeconds,
                    sample.GpuTemperature,
                    sample.MemoryTemperature,
                    Power = sample.TgpWatts,
                    sample.GpcClock,
                    sample.MemoryClock,
                }).ToArray(),
                CappingSegments = run.Analysis.InRangeCappingSegments.Select(segment => new
                {
                    Reason = segment.Label,
                    segment.StartSeconds,
                    segment.EndSeconds,
                    segment.DurationSeconds,
                }).ToArray(),
            }).ToArray();
            await JS.InvokeVoidAsync("gpuCharts.renderComparison", new object?[] { payload });
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    // Round half away from zero so displayed values match Excel (e.g. 83.195 -> 83.2).
    private static string Fmt(decimal? value) => value.HasValue ? Math.Round(value.Value, 2, MidpointRounding.AwayFromZero).ToString("0.##", CultureInfo.InvariantCulture) : "-";
    private static string Pct(decimal? value) => value.HasValue ? Math.Round(value.Value, 2, MidpointRounding.AwayFromZero).ToString("0.00", CultureInfo.InvariantCulture) + "%" : "n/a";
}